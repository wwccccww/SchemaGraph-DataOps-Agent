  "prediction": {
    "sql": "WITH returned_items AS (SELECT DISTINCT sr_item_sk, sr_store_sk, d_year FROM store_returns JOIN date_dim ON store_returns.sr_returned_date_sk = date_dim.d_date_sk JOIN reason ON store_returns.sr_reason_sk = reason.r_reason_sk WHERE d_year = 2001) SELECT s.s_state AS store_state, ca.ca_state AS customer_state, cd.cd_gender AS gender, ib.ib_lower_bound AS income_lower, p.p_promo_name AS promo_name, i.i_category AS item_category, d.d_year AS sales_year, SUM(ss.ss_ext_sales_price) AS sales_amount FROM store_sales AS ss JOIN date_dim AS d ON ss.ss_sold_date_sk = d.d_date_sk JOIN customer AS c ON ss.ss_customer_sk = c.c_customer_sk JOIN customer_address AS ca ON c.c_current_addr_sk = ca.ca_address_sk JOIN customer_demographics AS cd ON c.c_current_cdemo_sk = cd.cd_demo_sk JOIN household_demographics AS hd ON c.c_current_hdemo_sk = hd.hd_demo_sk JOIN income_band AS ib ON hd.hd_income_band_sk = ib.ib_income_band_sk JOIN item AS i ON ss.ss_item_sk = i.i_item_sk JOIN promotion AS p ON ss.ss_promo_sk = p.p_promo_sk JOIN store AS s ON ss.ss_store_sk = s.s_store_sk JOIN returned_items AS ri ON ri.sr_item_sk = ss.ss_item_sk AND ri.sr_store_sk = ss.ss_store_sk AND ri.d_year = d.d_year WHERE d.d_year = 2001 AND i.i_category = 'Electronics' GROUP BY s.s_state, ca.ca_state, cd.cd_gender, ib.ib_lower_bound, p.p_promo_name, i.i_category, d.d_year ORDER BY s.s_state, ca.ca_state, cd.cd_gender, ib.ib_lower_bound, p.p_promo_name, i.i_category, d.d_year",
