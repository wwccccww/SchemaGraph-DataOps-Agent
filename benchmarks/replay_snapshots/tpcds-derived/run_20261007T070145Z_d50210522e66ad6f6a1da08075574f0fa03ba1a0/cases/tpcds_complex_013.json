    "sql": "WITH filtered_sales AS (SELECT ws.ws_web_site_sk, ws.ws_item_sk, ws.ws_sales_price, ws.ws_ext_sales_price, ws.ws_sold_date_sk, bill_addr.ca_state AS bill_state, ship_addr.ca_state AS ship_state FROM web_sales AS ws JOIN customer AS c ON ws.ws_bill_customer_sk = c.c_customer_sk JOIN customer_address AS bill_addr ON ws.ws_bill_addr_sk = bill_addr.ca_address_sk JOIN customer_address AS ship_addr ON ws.ws_ship_addr_sk = ship_addr.ca_address_sk JOIN date_dim AS d ON ws.ws_sold_date_sk = d.d_date_sk WHERE d.d_year = 2001 AND bill_addr.ca_state <> ship_addr.ca_state) SELECT ws_site.web_name AS web_name, fs.bill_state AS bill_state, fs.ship_state AS ship_state, i.i_category AS item_category, d.d_year AS sales_year, SUM(fs.ws_ext_sales_price) AS sales_amount FROM filtered_sales AS fs JOIN web_site AS ws_site ON fs.ws_web_site_sk = ws_site.web_site_sk JOIN item AS i ON fs.ws_item_sk = i.i_item_sk JOIN date_dim AS d ON fs.ws_sold_date_sk = d.d_date_sk GROUP BY ws_site.web_name, fs.bill_state, fs.ship_state, i.i_category, d.d_year ORDER BY ws_site.web_name, fs.bill_state, fs.ship_state, i.i_category, d.d_year",
