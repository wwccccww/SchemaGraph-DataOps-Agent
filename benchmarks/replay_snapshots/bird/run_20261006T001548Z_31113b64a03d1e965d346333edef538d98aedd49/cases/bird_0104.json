  "prediction": {
    "sql": "WITH target_trans AS (SELECT t.trans_id, t.account_id, t.date AS transaction_date, t.amount, t.balance FROM trans AS t WHERE t.amount = 840 AND t.date = '1998-10-14'), acct AS (SELECT a.account_id, a.date AS account_opening_date, a.district_id FROM account AS a JOIN target_trans AS tt ON tt.account_id = a.account_id), owner AS (SELECT d.account_id, c.client_id, c.gender, c.birth_date FROM disp AS d JOIN client AS c ON c.client_id = d.client_id WHERE d.type = 'OWNER') SELECT acct.account_id AS account_id, acct.account_opening_date AS account_opening_date, tt.transaction_date AS transaction_date, CAST(JULIANDAY(tt.transaction_date) - JULIANDAY(acct.account_opening_date) AS INTEGER) AS days_account_open_before_transaction, tt.amount AS amount, tt.balance AS balance, dist.A2 AS district_name, dist.A3 AS region, owner.client_id AS client_id, CASE owner.gender WHEN 'M' THEN 'Male' WHEN 'F' THEN 'Female' ELSE 'Unknown' END AS gender_full, CAST((JULIANDAY(tt.transaction_date) - JULIANDAY(owner.birth_date)) / 365.25 AS INTEGER) AS age_at_transaction, (SELECT COUNT(*) FROM trans AS t2 WHERE t2.account_id = acct.account_id AND t2.date <= tt.transaction_date) AS total_transactions_to_date, (SELECT COUNT(*) FROM card AS cd JOIN disp AS d2 ON d2.disp_id = cd.disp_id WHERE d2.account_id = acct.account_id) AS cards_issued, CASE WHEN EXISTS(SELECT 1 FROM loan AS l WHERE l.account_id = acct.account_id AND l.date < tt.transaction_date) THEN 'Yes' ELSE 'No' END AS has_loan_before_transaction FROM target_trans AS tt JOIN acct ON acct.account_id = tt.account_id JOIN owner ON owner.account_id = acct.account_id JOIN district AS dist ON dist.district_id = acct.district_id",
