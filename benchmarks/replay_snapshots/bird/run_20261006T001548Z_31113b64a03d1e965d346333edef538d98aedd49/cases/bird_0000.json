  "prediction": {
    "sql": "WITH frpm_calc AS (SELECT frpm.CDSCode, frpm.\"County Name\" AS \"County\", frpm.\"School Name\" AS \"School Name\", frpm.\"Free Meal Count (K-12)\" AS \"FreeMealCount\", frpm.\"Enrollment (K-12)\" AS \"TotalEnrollment\", frpm.\"Free Meal Count (K-12)\" * 1.0 / frpm.\"Enrollment (K-12)\" AS free_rate FROM frpm WHERE frpm.\"County Name\" = 'Alameda' AND frpm.\"Enrollment (K-12)\" > 0), county_avg AS (SELECT AVG(free_rate) AS avg_rate FROM frpm_calc), top_school AS (SELECT * FROM frpm_calc ORDER BY free_rate DESC LIMIT 1) SELECT t.\"County\" AS \"County\", t.\"School Name\" AS \"School Name\", t.free_rate AS \"HighestFreeRate\", t.\"FreeMealCount\" AS \"FreeMealCount\", t.\"TotalEnrollment\" AS \"TotalEnrollment\", CASE WHEN s.Charter = 1 THEN 'Yes' WHEN s.Charter = 0 THEN 'No' ELSE 'Unknown' END AS \"IsCharterSchool\", s.GSserved AS \"GradesServed\", CASE WHEN sa.cds IS NULL OR (sa.AvgScrRead + sa.AvgScrMath + sa.AvgScrWrite) IS NULL THEN 'No SAT Data' WHEN (sa.AvgScrRead + sa.AvgScrMath + sa.AvgScrWrite) < 1200 THEN 'Below Average' WHEN (sa.AvgScrRead + sa.AvgScrMath + sa.AvgScrWrite) <= 1500 THEN 'Average' ELSE 'Above Average' END AS \"SATPerformance\", ca.avg_rate AS \"CountyAverageFreeRate\", t.free_rate - ca.avg_rate AS \"DeviationFromCountyAverage\" FROM top_school AS t JOIN schools AS s ON s.CDSCode = t.CDSCode LEFT JOIN satscores AS sa ON sa.cds = s.CDSCode CROSS JOIN county_avg AS ca",
