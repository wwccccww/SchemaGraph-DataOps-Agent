    "sql": "WITH base AS (SELECT s.School AS SchoolName, s.City AS City, s.Virtual AS VirtualStatus, s.GSserved AS SchoolType, ss.AvgScrMath AS MathScore, ss.AvgScrRead AS ReadingScore, ss.AvgScrWrite AS WritingScore, (ss.AvgScrRead + ss.AvgScrMath + ss.AvgScrWrite) AS TotalScore, f.\"Enrollment (K-12)\" AS Enrollment, f.\"Percent (%) Eligible FRPM (K-12)\" AS FRPMPercentage FROM schools AS s LEFT JOIN satscores AS ss ON ss.cds = s.CDSCode JOIN frpm AS f ON f.CDSCode = s.CDSCode WHERE s.Virtual = 'Fully Virtual' AND ss.AvgScrMath > 400) SELECT SchoolName, City, VirtualStatus, SchoolType, MathScore, ReadingScore, WritingScore, TotalScore, RANK() OVER (ORDER BY MathScore DESC) AS MathRank, RANK() OVER (ORDER BY TotalScore DESC) AS TotalScoreRank, Enrollment, CASE WHEN FRPMPercentage >= 75 THEN 'High FRPM' WHEN FRPMPercentage >= 50 THEN 'Medium FRPM' ELSE 'Low FRPM' END AS PovertyLevel, FRPMPercentage FROM base ORDER BY TotalScore DESC",
