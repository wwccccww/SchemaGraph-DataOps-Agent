  "prediction": {
    "sql": "WITH card_client AS (SELECT c.client_id, ca.card_id, ca.type AS card_type, c.gender, c.birth_date, c.district_id FROM card AS ca JOIN disp AS d ON ca.disp_id = d.disp_id JOIN client AS c ON d.client_id = c.client_id WHERE ca.issued = '1996-10-21'), client_accounts AS (SELECT cc.client_id, cc.card_id, cc.card_type, cc.gender, cc.birth_date, cc.district_id, a.account_id FROM card_client AS cc JOIN disp AS d2 ON d2.client_id = cc.client_id JOIN account AS a ON a.account_id = d2.account_id), trans_stats AS (SELECT ca.client_id, ca.card_id, ca.card_type, ca.gender, ca.birth_date, ca.district_id, t.trans_id, t.amount, t.type, t.date, t.balance, RANK() OVER (PARTITION BY ca.client_id ORDER BY t.amount DESC) AS amount_rank FROM client_accounts AS ca JOIN trans AS t ON t.account_id = ca.account_id) SELECT ts.client_id AS client_id, ts.card_id AS card_id, ts.card_type AS card_type, ts.gender AS gender, CAST(STRFTIME('%Y', '2026-10-01') AS INTEGER) - CAST(STRFTIME('%Y', ts.birth_date) AS INTEGER) - CASE WHEN STRFTIME('%m-%d', '2026-10-01') < STRFTIME('%m-%d', ts.birth_date) THEN 1 ELSE 0 END AS client_age, di.A2 AS district_name, di.A3 AS region, ts.trans_id AS trans_id, ts.amount AS largest_transaction_amount, ts.type AS transaction_type, ts.date AS transaction_date, ts.balance AS balance_after_transaction, CASE WHEN ts.amount >= 10000 THEN 'High Value' WHEN ts.amount >= 5000 THEN 'Medium Value' ELSE 'Low Value' END AS transaction_category, CASE WHEN EXISTS(SELECT 1 FROM client_accounts AS ca2 JOIN loan AS l ON l.account_id = ca2.account_id WHERE ca2.client_id = ts.client_id) THEN 'Has Loan' ELSE 'No Loan' END AS loan_status, (SELECT l.amount FROM client_accounts AS ca3 JOIN loan AS l ON l.account_id = ca3.account_id WHERE ca3.client_id = ts.client_id ORDER BY l.amount DESC LIMIT 1) AS loan_amount, (SELECT o.order_id FROM client_accounts AS ca4 JOIN \"order\" AS o ON o.account_id = ca4.account_id WHERE ca4.client_id = ts.client_id ORDER BY o.amount DESC LIMIT 1) AS order_id, (SELECT o.bank_to FROM client_accounts AS ca5 JOIN \"order\" AS o ON o.account_id = ca5.account_id WHERE ca5.client_id = ts.client_id ORDER BY o.amount DESC LIMIT 1) AS bank_to FROM trans_stats AS ts JOIN district AS di ON di.district_id = ts.district_id WHERE ts.amount_rank = 1 LIMIT 1",
