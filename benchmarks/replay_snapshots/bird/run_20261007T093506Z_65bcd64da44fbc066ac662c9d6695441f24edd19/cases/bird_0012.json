  "prediction": {
    "sql": "WITH base AS (\n  SELECT\n    s.School AS SchoolName,\n    s.County AS County,\n    s.City AS City,\n    CASE WHEN s.Charter = 1 THEN 'Charter School' ELSE 'Non-Charter School' END AS school_type,\n    CAST(ss.NumGE1500 AS REAL) / ss.NumTstTakr AS excellence_rate,\n    f.\"Free Meal Count (Ages 5-17)\" * 1.0 / f.\"Enrollment (Ages 5-17)\" AS eligible_free_rate\n  FROM schools s\n  JOIN satscores ss ON ss.cds = s.CDSCode\n  JOIN frpm f ON f.CDSCode = s.CDSCode\n  WHERE s.StatusType = 'Active'\n    AND ss.NumTstTakr > 0\n    AND CAST(ss.NumGE1500 AS REAL) / ss.NumTstTakr > 0.3\n    AND f.\"Enrollment (Ages 5-17)\" > 0\n),\nranked AS (\n  SELECT\n    *,\n    RANK() OVER (PARTITION BY County ORDER BY eligible_free_rate DESC) AS county_rank\n  FROM base\n)\nSELECT\n  SchoolName,\n  County,\n  City,\n  school_type,\n  excellence_rate,\n  eligible_free_rate,\n  county_rank,\n  (SELECT AVG(eligible_free_rate) FROM ranked) AS avg_eligible_free_rate,\n  CASE\n    WHEN eligible_free_rate > 0.5 THEN 'High Free Meal Rate'\n    WHEN eligible_free_rate > 0.25 THEN 'Medium Free Meal Rate'\n    ELSE 'Low Free Meal Rate'\n  END AS free_meal_category\nFROM ranked\nWHERE county_rank = 1\nORDER BY eligible_free_rate DESC\nLIMIT 1;",
