  "prediction": {
    "sql": "WITH LoanStats AS (SELECT l.loan_id, l.account_id, l.amount, l.duration, l.status, a.district_id FROM loan AS l JOIN account AS a ON l.account_id = a.account_id WHERE l.loan_id = 4990), DistrictStats AS (SELECT a.district_id, COUNT(l.loan_id) AS district_total_loans, AVG(l.amount) AS district_avg_loan_amount, SUM(CASE WHEN l.status IN ('B', 'D') THEN 1 ELSE 0 END) AS district_problematic_loans FROM loan AS l JOIN account AS a ON l.account_id = a.account_id GROUP BY a.district_id), LoanRank AS (SELECT l.loan_id, RANK() OVER (PARTITION BY a.district_id ORDER BY l.amount DESC) AS district_loan_rank FROM loan AS l JOIN account AS a ON l.account_id = a.account_id) SELECT ls.loan_id AS loan_id, d.A2 AS district_name, d.A3 AS region, c.gender AS gender, c.birth_date AS birth_date, ls.amount AS loan_amount, ls.duration AS loan_duration_months, CASE ls.status WHEN 'A' THEN 'Running - OK' WHEN 'B' THEN 'Running - Issues' WHEN 'C' THEN 'Finished - No Issues' WHEN 'D' THEN 'Finished - Issues' END AS status_description, d.A11 AS district_avg_salary, d.A12 AS unemployment_rate_1995, ds.district_total_loans AS district_total_loans, ds.district_avg_loan_amount AS district_avg_loan_amount, ds.district_problematic_loans AS district_problematic_loans, lr.district_loan_rank AS district_loan_rank, (SELECT COUNT(*) FROM trans AS t WHERE t.account_id = ls.account_id) AS total_transactions FROM LoanStats AS ls JOIN district AS d ON ls.district_id = d.district_id JOIN DistrictStats AS ds ON ls.district_id = ds.district_id JOIN LoanRank AS lr ON ls.loan_id = lr.loan_id JOIN disp AS dp ON dp.account_id = ls.account_id AND dp.type = 'OWNER' JOIN client AS c ON dp.client_id = c.client_id",
