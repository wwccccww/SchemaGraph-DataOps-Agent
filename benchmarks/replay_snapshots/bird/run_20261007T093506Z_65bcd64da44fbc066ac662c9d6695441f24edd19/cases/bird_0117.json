  "prediction": {
    "sql": "WITH LoansByDistrict AS (SELECT d.A3 AS region, l.loan_id, l.amount, l.status, (l.payments * l.duration - l.amount) AS interest_paid FROM loan AS l JOIN account AS a ON l.account_id = a.account_id JOIN disp AS dp ON a.account_id = dp.account_id AND dp.type = 'OWNER' JOIN client AS c ON dp.client_id = c.client_id JOIN district AS d ON a.district_id = d.district_id), RegionSummary AS (SELECT region, SUM(CASE WHEN status = 'A' THEN amount ELSE 0 END) AS paid_amount, SUM(amount) AS total_amount, SUM(CASE WHEN status = 'A' THEN 1 ELSE 0 END) AS successful_loans, COUNT(*) AS total_loans, AVG(CASE WHEN status = 'A' THEN interest_paid END) AS avg_interest_paid_successful, AVG(interest_paid) AS avg_interest_paid_all FROM LoansByDistrict GROUP BY region) SELECT region, ROUND(paid_amount * 100.0 / total_amount, 2) AS paid_amount_percentage, ROUND(successful_loans * 100.0 / total_loans, 2) AS successful_loans_percentage, successful_loans, total_loans, paid_amount, total_amount, ROUND(avg_interest_paid_successful, 2) AS avg_interest_paid_successful, ROUND(avg_interest_paid_all, 2) AS avg_interest_paid_all, (SELECT ROUND(SUM(CASE WHEN status = 'A' THEN amount ELSE 0 END) * 100.0 / SUM(amount), 2) FROM loan) AS overall_percentage FROM RegionSummary ORDER BY paid_amount_percentage DESC",
