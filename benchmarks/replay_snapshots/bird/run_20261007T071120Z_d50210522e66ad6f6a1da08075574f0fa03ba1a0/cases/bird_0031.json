  "prediction": {
    "sql": "WITH EnrollmentRanked AS (\n  SELECT\n    f.CDSCode,\n    f.\"School Name\" AS \"School Name\",\n    f.\"District Name\" AS \"District Name\",\n    f.\"County Name\" AS \"County Name\",\n    f.\"Enrollment (K-12)\" AS TotalEnrollment,\n    f.\"Free Meal Count (K-12)\" AS FreeMealCount,\n    ROW_NUMBER() OVER (ORDER BY f.\"Enrollment (K-12)\" DESC) AS EnrollmentRank\n  FROM frpm AS f\n  WHERE f.\"Enrollment (K-12)\" IS NOT NULL\n),\nSchoolDetails AS (\n  SELECT\n    er.EnrollmentRank,\n    er.\"School Name\",\n    er.\"District Name\",\n    er.\"County Name\",\n    er.TotalEnrollment,\n    er.FreeMealCount,\n    ROUND(er.FreeMealCount * 1.0 / er.TotalEnrollment * 100, 2) || '%' AS EligibleFreeRate,\n    s.City,\n    CASE WHEN s.Charter = 1 THEN 'Charter School' ELSE 'Regular School' END AS SchoolType,\n    s.GSoffered AS GradeSpan,\n    s.Website,\n    er.CDSCode\n  FROM EnrollmentRanked AS er\n  JOIN schools AS s ON s.CDSCode = er.CDSCode\n  WHERE er.EnrollmentRank IN (10, 11)\n)\nSELECT\n  sd.EnrollmentRank,\n  sd.\"School Name\",\n  sd.\"District Name\",\n  sd.\"County Name\",\n  sd.TotalEnrollment,\n  sd.FreeMealCount,\n  sd.EligibleFreeRate,\n  sd.City,\n  sd.SchoolType,\n  sd.GradeSpan,\n  sd.Website,\n  ss.NumTstTakr AS SATTestTakers,\n  ss.AvgScrRead AS AvgReadingScore,\n  ss.AvgScrMath AS AvgMathScore,\n  ss.AvgScrWrite AS AvgWritingScore,\n  COALESCE(ROUND(ss.NumGE1500 * 1.0 / ss.NumTstTakr * 100, 2), 0) || '%' AS PercentAbove1500SAT\nFROM SchoolDetails AS sd\nLEFT JOIN satscores AS ss ON ss.cds = sd.CDSCode AND ss.rtype = 'S'\nORDER BY sd.EnrollmentRank;",
