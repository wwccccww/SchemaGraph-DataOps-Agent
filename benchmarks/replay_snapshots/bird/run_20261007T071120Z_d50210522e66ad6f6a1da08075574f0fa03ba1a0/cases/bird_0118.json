  "prediction": {
    "sql": "WITH filtered_loans AS (SELECT d.A3 AS region, CASE WHEN l.amount < 50000 THEN 'Small' WHEN l.amount < 100000 THEN 'Medium' ELSE 'Large' END AS loan_size_category, l.status, l.amount, l.duration FROM loan AS l JOIN account AS a ON l.account_id = a.account_id JOIN district AS d ON a.district_id = d.district_id WHERE l.amount < 100000), region_stats AS (SELECT region, loan_size_category, COUNT(status) AS total_loans, SUM(CASE WHEN status = 'C' THEN 1 ELSE 0 END) AS running_ok_loans, CAST(SUM(CASE WHEN status = 'C' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(status) AS percentage_running_ok, AVG(amount) AS avg_loan_amount, AVG(duration) AS avg_duration FROM filtered_loans GROUP BY region, loan_size_category), overall_stats AS (SELECT loan_size_category, CAST(SUM(CASE WHEN status = 'C' THEN 1 ELSE 0 END) AS REAL) * 100 / COUNT(status) AS overall_percentage FROM filtered_loans GROUP BY loan_size_category) SELECT r.region AS region, r.loan_size_category AS loan_size_category, r.total_loans AS total_loans, r.running_ok_loans AS running_ok_loans, ROUND(r.percentage_running_ok, 2) AS percentage_running_ok, ROUND(r.avg_loan_amount, 2) AS avg_loan_amount, r.avg_duration AS avg_duration, ROUND(o.overall_percentage, 2) AS overall_percentage, ROUND(r.percentage_running_ok - o.overall_percentage, 2) AS diff_from_overall FROM region_stats AS r JOIN overall_stats AS o ON r.loan_size_category = o.loan_size_category ORDER BY r.region, r.loan_size_category",
