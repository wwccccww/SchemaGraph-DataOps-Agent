  "prediction": {
    "sql": "WITH school_sat AS (SELECT s.CDSCode, s.School AS \"School Name\", s.Phone AS \"Contact Number\", s.City AS \"City\", CASE WHEN s.Charter = 1 THEN 'Yes' WHEN s.Charter = 0 THEN 'No' ELSE 'Unknown' END AS \"Charter School\", ss.NumGE1500, ss.NumTstTakr, CAST(ss.NumGE1500 AS REAL) / ss.NumTstTakr AS excellence_rate, f.\"Percent (%) Eligible FRPM (K-12)\" AS poverty_rate FROM schools AS s JOIN satscores AS ss ON ss.cds = s.CDSCode JOIN frpm AS f ON f.CDSCode = s.CDSCode WHERE ss.rtype = 'S' AND ss.NumTstTakr > 0 AND s.StatusType = 'Active'), ranked AS (SELECT *, RANK() OVER (ORDER BY excellence_rate DESC) AS sat_rank FROM school_sat) SELECT sat_rank AS \"SAT Excellence Rank\", \"School Name\", excellence_rate AS \"SAT Excellence Rate\", NumGE1500 || '/' || NumTstTakr AS \"High Scorers/Test Takers\", \"Contact Number\", \"City\", \"Charter School\", poverty_rate AS \"Poverty Rate\", CASE WHEN poverty_rate > 0.75 THEN 'High Poverty' WHEN poverty_rate > 0.50 THEN 'Medium Poverty' WHEN poverty_rate > 0.25 THEN 'Low Poverty' ELSE 'Very Low Poverty' END AS \"Poverty Category\" FROM ranked WHERE sat_rank <= 3 ORDER BY sat_rank",
