# 复制为 .env 后替换占位密码。不要提交 .env，也不要把真实密码写进仓库。
# P0/P1 外部 Gold：见 docs/external_gold_p0_runbook.md
# ./scripts/p1_release_gate.sh 或 402 期间 ./scripts/p0_post_billing_acceptance.sh --gates-only
# 计费恢复后：./scripts/p0_post_billing_acceptance.sh（打印 p0_measured_* 写入 docs/benchmark.md）
# 或无人值守：./scripts/wait_for_billing_and_run_p0.sh（P0_BILLING_POLL_SECONDS 默认 300）
# P0_BIRD_MIN_MATCHED=13  # optional BIRD acceptance floor per run (default 13/50 after v11 measured)
POSTGRES_USER=text2sql_admin
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=text2sql_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# TPC-DS Oracle/replay 连 catalog 库（默认 tpcds，与 POSTGRES_DB 可不同）；占位密码会导致 replay 单测 skip、verify 失败
# TPCDS_POSTGRES_DB=tpcds
# 外部 BIRD Oracle / replay（verify-bird、P0/P1 门禁）；指向 MINIDEV dev_databases 目录
BIRD_DATABASE_ROOT=/path/to/bird_dev/minidev/MINIDEV/dev_databases
SANDBOX_DB_PASSWORD=replace-with-local-sandbox-password
API_HOST=0.0.0.0
API_PORT=8000
# 只有调用 DeepSeek 时才需要。占位符会被拒绝；不调用模型就删掉下一行。
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
