# 复制为 .env 后替换占位密码。不要提交 .env，也不要把真实密码写进仓库。
POSTGRES_USER=text2sql_admin
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=text2sql_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SANDBOX_DB_PASSWORD=replace-with-local-sandbox-password
API_HOST=0.0.0.0
API_PORT=8000
# 只有调用 DeepSeek 时才需要。占位符会被拒绝；不调用模型就删掉下一行。
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 问数 Catalog：默认 live_public；fixed_ecommerce 锁定电商 12 表
# TEXT_TO_SQL_CATALOG_MODE=live_public
# SCHEMA_REGISTRY_AUTO_ACTIVATE=true
# SCHEMA_REGISTRY_AUTO_INDEX=false
# SCHEMA_REGISTRY_REQUIRE_EMBEDDINGS=false
# SCHEMA_REGISTRY_PERSIST=false
# SCHEMA_REGISTRY_ALLOW_FORCE=false
# SCHEMA_REGISTRY_TENANT_ALLOWLIST=
